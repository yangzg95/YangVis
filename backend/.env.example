# Application
APP_NAME=YangVis
PORT=18099
CONTEXT_PATH=/tool

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=__CHANGE_ME__
DB_NAME=YangVis

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=20

# Knowledge base
KB_MAX_UPLOAD_BYTES=10485760
KB_EMBED_BATCH_SIZE=16
# Retrieval hits below this cosine score are discarded. Raise it if answers
# cite loosely related material; lower it if relevant chunks are being missed.
KB_SCORE_THRESHOLD=0.3

# Authentication (self-hosted JWT, see docs)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=__CHANGE_ME__

# Encrypts stored model api_keys. Required; rotating it makes every stored
# key undecryptable, so treat it as permanent.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=__CHANGE_ME__

# Timeout for outbound calls to user-configured model providers.
MODEL_HTTP_TIMEOUT=30

# Bootstrap admin (first-start only; kept empty after initial run)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-password

# Baidu Netdisk (xpan open platform) — resume file backup for the office module.
# Leave empty to disable the feature entirely (the UI hides the entry).
# BAIDU_NETDISK_APP_KEY=
# BAIDU_NETDISK_SECRET_KEY=
# App directory name from the open-platform console; files live under /apps/<name>/
# BAIDU_NETDISK_APP_NAME=
# BAIDU_NETDISK_REDIRECT_URI=oob
