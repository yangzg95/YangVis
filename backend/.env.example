# Application
APP_NAME=YangVis
PORT=18099

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=__CHANGE_ME__
DB_NAME=YangVis

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_TIMEOUT=20

# Knowledge base
KB_MAX_UPLOAD_BYTES=10485760
KB_EMBED_BATCH_SIZE=16
# Retrieval hits below this cosine score are discarded. Raise it if answers
# cite loosely related material; lower it if relevant chunks are being missed.
KB_SCORE_THRESHOLD=0.3

# Authentication (self-hosted JWT, see docs)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=__CHANGE_ME__

# Encrypts stored model api_keys. Required; rotating it makes every stored
# key undecryptable, so treat it as permanent.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=__CHANGE_ME__

# Timeout for outbound calls to user-configured model providers.
MODEL_HTTP_TIMEOUT=30
# Streaming chat gets its own, much longer timeout: it is the idle gap between
# two chunks, and reasoning models can easily stay silent for a minute.
CHAT_MODEL_TIMEOUT=180

# AI gateway (/v1/* OpenAI-compatible proxy: one shared key → many upstreams)
AI_GATEWAY_CONNECT_TIMEOUT=10
AI_GATEWAY_READ_TIMEOUT=300
# Whether request/response bodies are written into ai_call_log for audit.
AI_GATEWAY_LOG_PAYLOAD=true
# Truncation limit per body (characters).
AI_GATEWAY_LOG_MAX_CHARS=8000
# Max upstream attempts per call (priority-ordered failover).
AI_GATEWAY_MAX_ATTEMPTS=3
# model="auto": let one candidate route classify the task kind (reasoning / code /
# writing / translation / general) before ranking. Hard requirements (embedding /
# vision / tools) are always decided by rules, never by this call. Set false to
# rank purely by priority.
AI_GATEWAY_AUTO_LLM=true
# Standalone timeout for that classification, in seconds. Timeout or a bad answer
# just falls back to priority order — it never fails the caller's request.
AI_GATEWAY_AUTO_CLASSIFY_TIMEOUT=8
# How much of the last user turn is sent to the classifier (characters).
AI_GATEWAY_AUTO_CLASSIFY_CHARS=1200
# Public origin shown as the gateway base_url in the admin overview. Set it when
# the gateway is served from its own domain; leave empty to derive it from the
# request that opens the console. The "/v1" suffix is always appended.
# AI_GATEWAY_PUBLIC_ORIGIN=https://ai.nanwa.xyz

# Bootstrap admin (first-start only; kept empty after initial run)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-password

# Baidu Netdisk (xpan open platform) — resume file backup for the office module.
# Leave empty to disable the feature entirely (the UI hides the entry).
# BAIDU_NETDISK_APP_KEY=
# BAIDU_NETDISK_SECRET_KEY=
# App directory name from the open-platform console; files live under /apps/<name>/
# BAIDU_NETDISK_APP_NAME=
# BAIDU_NETDISK_REDIRECT_URI=oob

# Bocha web search (https://open.bochaai.com) — backs the web_search local tool.
# Leave empty to disable; the tool then replies with a "not enabled" hint instead
# of failing the turn.
# BOCHA_API_KEY=

# Mobile app (yangvis-app) notification inbox and SSE stream:
# /api/app/v1/messages and /api/app/v1/messages/stream.
# The background connection uses this long-lived bearer token instead of the
# console's 12-hour JWT. Both settings are required; otherwise these endpoints
# return 404. Never allow one token to read notifications across owners.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOTIFY_APP_TOKEN=
# NOTIFY_APP_OWNER_ID=
# Whether this process claims media jobs (short-video frames/clips). Set it to
# false on any machine that shares the database with another running instance:
# media jobs have no cross-process claim, so whichever process polls first runs
# the provider call and writes the artifact to its OWN disk - the other one then
# 404s on the same row, and a doubled claim means a doubled charge. Default true.
# MEDIA_JOB_LOOP_ENABLED=true
#
# How reference images reach Ark: "data_url" (default) reads the local artifact
# and inlines it as base64; "public_url" sends PUBLIC_MEDIA_BASE_URL + the
# artifact path instead. Keep data_url unless /uploads is reachable from the
# public internet - it is not on a dev machine.
# MEDIA_IMAGE_TRANSPORT=data_url
#
# Public origin of this site, e.g. https://yangvis.nanwa.xyz. REQUIRED by the
# short-video "reference the previous clip" switch: Ark's video_url accepts only
# a public URL or an asset:// id, never base64, so Ark must be able to fetch the
# rendered clip from the internet. Empty = that switch is refused at enqueue
# time and the UI disables it. Note /uploads carries no auth (it relies on
# unguessable random filenames), so only set this if you accept that exposure.
# PUBLIC_MEDIA_BASE_URL=
#
# Max seconds one final-video composition (ffmpeg concat of the rendered clips)
# may run before the process kills it and marks the publish job failed. Local
# work normally finishes in seconds; the guard only catches a stuck re-encode.
# PUBLISH_COMPOSE_TIMEOUT=300
#
# TTS voiceover (a model_config row with purpose "tts" is still required).
# TTS_DEFAULT_VOICE is the fallback voice id when a video project leaves its
# own voice blank: for the openspeech Agent Plan endpoint this is the speaker
# id (e.g. zh_female_vv_uranus_bigtts); for OpenAI-compatible endpoints it is
# the voice parameter. Leave both empty and the compose gate refuses with a
# clear message instead of guessing a voice.
# TTS_DEFAULT_VOICE=
# TTS_HTTP_TIMEOUT=60
# TTS_AUDIO_MAX_BYTES=10485760
# Max speed-up applied when a spoken line is longer than its shot slot.
# Beyond this the publish job fails and asks the user to trim the dialogue.
# TTS_MAX_ATEMPO=1.6
# TTS_SAMPLE_RATE=44100
